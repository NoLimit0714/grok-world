# Bind localhost only. Use Tailscale if personal Grok must call IN.
# Never set 0.0.0.0 with a weak token (bridge will refuse).
GROK_WORLD_HOST=127.0.0.1
GROK_WORLD_PORT=8787

# Local UI token — run: .\scripts\ensure-secrets.ps1
GROK_WORLD_TOKEN=dev-local-token-change-me

# Optional separate token for personal Grok / inbound agents (defaults to GROK_WORLD_TOKEN)
# GROK_AGENT_TOKEN=

# Extra CORS origins (comma-separated). Localhost always allowed.
# GROK_WORLD_CORS_ORIGINS=https://your-machine.ts.net

# Low-call mode (default): local job scripts + optional personal Grok wakes
GROK_WORLD_LOW_CALL=true
# Webhook only on job_start; set false to skip job_done wakes too
GROK_WEBHOOK_ON_DONE=true

# Optional xAI (NOT needed for low-call watch mode — leave blank to save money)
# XAI_API_KEY=
# XAI_MODEL=grok-2-latest
# XAI_BASE_URL=https://api.x.ai/v1

# Personal Grok app — rare wakes (job_start / job_done only)
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=
GROK_WEBHOOK_ENABLED=true

# Web (optional)
# VITE_GROK_WORLD_TOKEN=
# VITE_BRIDGE_HTTP=http://127.0.0.1:8787
